---
// AuditModal.astro
---

<dialog id="auditModal" class="bg-transparent m-auto p-2 sm:p-4 w-full max-w-6xl rounded-3xl backdrop:bg-brand-midnight/90 backdrop:backdrop-blur-sm relative overflow-visible">
  
  <div class="bg-brand-midnight border border-white/10 rounded-2xl p-5 sm:p-8 md:p-16 overflow-hidden relative shadow-[0_0_50px_rgba(79,70,229,0.15)] mx-auto max-h-[95vh] sm:max-h-[90vh] overflow-y-auto w-full">
    <button id="closeAuditModal" class="absolute top-3 right-3 sm:top-4 sm:right-4 z-50 text-white/50 hover:text-white bg-white/5 hover:bg-white/10 rounded-full p-1.5 sm:p-2 transition-colors border border-white/10 cursor-pointer">
      <svg class="w-5 h-5 sm:w-6 sm:h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
    </button>
    <div class="absolute top-0 right-0 w-64 h-64 bg-gradient-to-bl from-brand-indigo/20 to-transparent rounded-2xl pointer-events-none"></div>

    <div class="grid lg:grid-cols-2 gap-8 md:gap-12 items-center relative z-10">
      {/* Left — pitch copy */}
      <div>
        <div class="badge-cyan mb-3 sm:mb-4">Free Audit</div>
        <h2 class="text-2xl sm:text-3xl md:text-5xl font-heading font-bold text-white mb-4 sm:mb-6">Find out exactly how much money you are leaving on the table.</h2>
        <p class="text-sm sm:text-lg text-white/60 mb-6 sm:mb-8">
          Every day you wait, your competitors are capturing leads that should have been yours. Fill out the form, and we will show you exactly how to take them back.
        </p>
        <div class="space-y-4">
          <div class="flex items-center gap-3 text-white">
            <svg class="w-5 h-5 text-brand-cyan shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            <span class="font-bold">Total local search volume reveal</span>
          </div>
          <div class="flex items-center gap-3 text-white">
            <svg class="w-5 h-5 text-brand-cyan shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            <span class="font-bold">Ruthless competitor analysis</span>
          </div>
          <div class="flex items-center gap-3 text-white">
            <svg class="w-5 h-5 text-brand-cyan shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            <span class="font-bold">Step-by-step blueprint to dominate</span>
          </div>
        </div>
      </div>

      {/* Right — premium form card */}
      <div class="rounded-3xl overflow-hidden border border-white/10 shadow-2xl relative">
        {/* Card header */}
        <div class="bg-white/5 border-b border-white/10 px-5 py-3 sm:px-7 sm:py-4 flex items-center justify-between">
          <div>
            <p class="text-[9px] sm:text-[10px] font-black uppercase tracking-[0.15em] text-brand-cyan mb-0.5">Quick Form — 60 seconds</p>
            <h3 class="text-white font-bold text-sm sm:text-base leading-none">Tell us about your business</h3>
          </div>
          <div class="flex items-center gap-1 sm:gap-1.5">
            <span class="w-2 h-2 sm:w-2.5 sm:h-2.5 rounded-full bg-brand-coral/70"></span>
            <span class="w-2 h-2 sm:w-2.5 sm:h-2.5 rounded-full bg-brand-indigo/70"></span>
            <span class="w-2 h-2 sm:w-2.5 sm:h-2.5 rounded-full bg-brand-cyan/70"></span>
          </div>
        </div>

        <div class="bg-white/3 px-5 py-5 sm:px-7 sm:py-7 relative">
          <div class="absolute top-0 right-0 w-40 h-40 bg-brand-indigo/10 blur-[60px] rounded-full pointer-events-none"></div>

          <form action="/api/contact" method="POST" class="space-y-4 sm:space-y-5 relative">
            {/* Business Name */}
            <div>
              <label for="modal-name" class="block text-[10px] font-black uppercase tracking-[0.12em] text-white/40 mb-2">Business Name</label>
              <div class="relative group/input">
                <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-white/20 group-focus-within/input:text-brand-indigo transition-colors duration-200">
                  <svg class="w-[15px] h-[15px] sm:w-[17px] sm:h-[17px]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" /></svg>
                </div>
                <input type="text" id="modal-name" name="name" required
                  class="w-full bg-white/5 border border-white/10 rounded-xl pl-10 pr-3 sm:pr-4 py-2.5 sm:py-3 text-white text-sm focus:outline-none focus:ring-2 focus:ring-brand-indigo/40 focus:border-brand-indigo/60 transition-all duration-200 placeholder:text-white/15"
                  placeholder="e.g. Apex Fitness Studio" />
              </div>
            </div>

            {/* Email */}
            <div>
              <label for="modal-email" class="block text-[10px] font-black uppercase tracking-[0.12em] text-white/40 mb-2">Email Address</label>
              <div class="relative group/input">
                <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-white/20 group-focus-within/input:text-brand-indigo transition-colors duration-200">
                  <svg class="w-[15px] h-[15px] sm:w-[17px] sm:h-[17px]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
                </div>
                <input type="email" id="modal-email" name="email" required
                  class="w-full bg-white/5 border border-white/10 rounded-xl pl-10 pr-3 sm:pr-4 py-2.5 sm:py-3 text-white text-sm focus:outline-none focus:ring-2 focus:ring-brand-indigo/40 focus:border-brand-indigo/60 transition-all duration-200 placeholder:text-white/15"
                  placeholder="owner@yourbusiness.com" />
              </div>
            </div>

            {/* Phone */}
            <div>
              <label for="modal-phone" class="block text-[10px] font-black uppercase tracking-[0.12em] text-white/40 mb-2">Phone Number</label>
              <div class="relative group/input">
                <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-white/20 group-focus-within/input:text-brand-indigo transition-colors duration-200">
                  <svg class="w-[15px] h-[15px] sm:w-[17px] sm:h-[17px]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
                </div>
                <input type="tel" id="modal-phone" name="phone" required
                  class="w-full bg-white/5 border border-white/10 rounded-xl pl-10 pr-3 sm:pr-4 py-2.5 sm:py-3 text-white text-sm focus:outline-none focus:ring-2 focus:ring-brand-indigo/40 focus:border-brand-indigo/60 transition-all duration-200 placeholder:text-white/15"
                  placeholder="(555) 000-0000" />
              </div>
            </div>

            {/* Time to Call — pill selectors */}
            <div>
              <div class="flex items-center gap-2 mb-3">
                <svg class="w-3.5 h-3.5 text-brand-cyan shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                <span class="text-[10px] font-black uppercase tracking-[0.12em] text-white/40">Best Time to Call</span>
              </div>
              <div class="grid grid-cols-3 gap-2 sm:gap-2.5">
                <label class="cursor-pointer">
                  <input type="radio" name="timeToCall" value="Morning" class="peer sr-only" required />
                  <div class="relative flex flex-col items-center gap-1 sm:gap-1.5 py-3 sm:py-4 px-1 rounded-xl bg-white/5 border border-white/8 text-white/35 peer-checked:bg-brand-indigo/15 peer-checked:border-brand-indigo/60 peer-checked:text-white hover:bg-white/8 hover:text-white/60 transition-all duration-200 overflow-hidden select-none">
                    <div class="absolute top-0 inset-x-0 h-[2px] bg-gradient-to-r from-brand-indigo to-brand-cyan opacity-0 peer-checked:opacity-100 transition-opacity duration-300 rounded-t-xl"></div>
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 9h-1m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" /></svg>
                    <span class="text-[9px] font-black uppercase tracking-wider">Morning</span>
                    <span class="text-[8px] text-white/40 font-medium">9am – 12pm</span>
                  </div>
                </label>

                <label class="cursor-pointer">
                  <input type="radio" name="timeToCall" value="Afternoon" class="peer sr-only" />
                  <div class="relative flex flex-col items-center gap-1 sm:gap-1.5 py-3 sm:py-4 px-1 rounded-xl bg-white/5 border border-white/8 text-white/35 peer-checked:bg-brand-cyan/15 peer-checked:border-brand-cyan/60 peer-checked:text-white hover:bg-white/8 hover:text-white/60 transition-all duration-200 overflow-hidden select-none">
                    <div class="absolute top-0 inset-x-0 h-[2px] bg-gradient-to-r from-brand-cyan to-brand-indigo opacity-0 peer-checked:opacity-100 transition-opacity duration-300 rounded-t-xl"></div>
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z" /></svg>
                    <span class="text-[9px] font-black uppercase tracking-wider">Noon</span>
                    <span class="text-[8px] text-white/40 font-medium">12pm – 5pm</span>
                  </div>
                </label>

                <label class="cursor-pointer">
                  <input type="radio" name="timeToCall" value="Evening" class="peer sr-only" />
                  <div class="relative flex flex-col items-center gap-1 sm:gap-1.5 py-3 sm:py-4 px-1 rounded-xl bg-white/5 border border-white/8 text-white/35 peer-checked:bg-brand-coral/15 peer-checked:border-brand-coral/60 peer-checked:text-white hover:bg-white/8 hover:text-white/60 transition-all duration-200 overflow-hidden select-none">
                    <div class="absolute top-0 inset-x-0 h-[2px] bg-gradient-to-r from-brand-coral to-brand-orange opacity-0 peer-checked:opacity-100 transition-opacity duration-300 rounded-t-xl"></div>
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" /></svg>
                    <span class="text-[9px] font-black uppercase tracking-wider">Evening</span>
                    <span class="text-[8px] text-white/40 font-medium">5pm – 8pm</span>
                  </div>
                </label>
              </div>
            </div>

            {/* Submit */}
            <div class="pt-2 border-t border-white/8">
              <button type="submit" class="group relative w-full bg-brand-coral hover:bg-brand-coral/90 text-white font-bold py-3 sm:py-3.5 px-6 rounded-xl transition-all duration-300 shadow-glow-coral hover:-translate-y-0.5 active:scale-95 flex items-center justify-center gap-2 overflow-hidden text-sm">
                <span class="relative z-10">Get My Free Audit</span>
                <svg class="w-4 h-4 relative z-10 transition-transform group-hover:translate-x-1 duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
                <div class="absolute inset-0 bg-gradient-to-r from-white/0 via-white/15 to-white/0 -translate-x-full group-hover:translate-x-full transition-transform duration-700"></div>
              </button>
              <p class="text-center text-[10px] text-white/20 mt-2.5 tracking-wide">No spam · No commitment · Free & confidential</p>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</dialog>

<style>
  dialog::backdrop {
    background-color: rgba(10, 15, 30, 0.85); /* Matches brand-midnight approx */
    backdrop-filter: blur(8px);
  }
  
  dialog {
    border: none;
    color: inherit;
  }
  
  dialog[open] {
    animation: modalSlideIn 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  
  @keyframes modalSlideIn {
    from {
      opacity: 0;
      transform: translateY(20px) scale(0.95);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }
</style>

<script>
  // Script to handle modal open/close logic from any button
  const modal = document.getElementById('auditModal') as HTMLDialogElement;
  const closeBtn = document.getElementById('closeAuditModal');
  
  // Close modal when clicking close button
  if (closeBtn && modal) {
    closeBtn.addEventListener('click', () => {
      modal.close();
    });
  }
  
  // Close modal when clicking outside the dialog content
  if (modal) {
    modal.addEventListener('click', (e) => {
      const dialogDimensions = modal.getBoundingClientRect();
      if (
        e.clientX < dialogDimensions.left ||
        e.clientX > dialogDimensions.right ||
        e.clientY < dialogDimensions.top ||
        e.clientY > dialogDimensions.bottom
      ) {
        modal.close();
      }
    });
  }

  // Export a function or handle custom events or data-attributes
  // For easier usage, let's add event listeners to all elements with data-open-modal="auditModal"
  document.querySelectorAll('[data-open-modal="auditModal"]').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      if (modal) {
        modal.showModal();
      }
    });
  });
</script>
