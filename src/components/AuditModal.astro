---
// AuditModal.astro
---

<dialog id="auditModal" class="bg-transparent m-auto p-2 sm:p-4 w-full max-w-6xl rounded-3xl backdrop:bg-brand-midnight/90 backdrop:backdrop-blur-sm relative overflow-visible">
  
  <div class="bg-brand-midnight border border-white/10 rounded-2xl p-5 sm:p-8 md:p-16 overflow-hidden relative shadow-[0_0_50px_rgba(79,70,229,0.15)] mx-auto max-h-[95vh] sm:max-h-[90vh] overflow-y-auto w-full">
    <button id="closeAuditModal" class="absolute top-3 right-3 sm:top-4 sm:right-4 z-50 text-white/50 hover:text-white bg-white/5 hover:bg-white/10 rounded-full p-1.5 sm:p-2 transition-colors border border-white/10 cursor-pointer">
      <svg class="w-5 h-5 sm:w-6 sm:h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
    </button>
    <div class="absolute top-0 right-0 w-64 h-64 bg-gradient-to-bl from-brand-indigo/20 to-transparent rounded-2xl pointer-events-none"></div>

    <div class="grid lg:grid-cols-2 gap-8 md:gap-12 items-center relative z-10">
      {/* Left — pitch copy */}
      <div>
        <div class="badge-cyan mb-3 sm:mb-4">Free Audit</div>
        <h2 class="text-2xl sm:text-3xl md:text-5xl font-heading font-bold text-white mb-4 sm:mb-6">Find out exactly how much money you are leaving on the table.</h2>
        <p class="text-sm sm:text-lg text-white/60 mb-6 sm:mb-8">
          Every day you wait, your competitors are capturing leads that should have been yours. Fill out the form, and we will show you exactly how to take them back.
        </p>
        <div class="space-y-4">
          <div class="flex items-center gap-3 text-white">
            <svg class="w-5 h-5 text-brand-cyan shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            <span class="font-bold">Total local search volume reveal</span>
          </div>
          <div class="flex items-center gap-3 text-white">
            <svg class="w-5 h-5 text-brand-cyan shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            <span class="font-bold">Ruthless competitor analysis</span>
          </div>
          <div class="flex items-center gap-3 text-white">
            <svg class="w-5 h-5 text-brand-cyan shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            <span class="font-bold">Step-by-step blueprint to dominate</span>
          </div>
        </div>
      </div>

      {/* Right — premium form card */}
      <div class="rounded-3xl overflow-hidden border border-white/10 shadow-2xl relative">
        {/* Card header */}
        <div class="bg-white/5 border-b border-white/10 px-5 py-3 sm:px-7 sm:py-4 flex items-center justify-between">
          <div>
            <p class="text-[9px] sm:text-[10px] font-black uppercase tracking-[0.15em] text-brand-cyan mb-0.5">Quick Form — 60 seconds</p>
            <h3 class="text-white font-bold text-sm sm:text-base leading-none">Tell us about your business</h3>
          </div>
          <div class="flex items-center gap-1 sm:gap-1.5">
            <span class="w-2 h-2 sm:w-2.5 sm:h-2.5 rounded-full bg-brand-coral/70"></span>
            <span class="w-2 h-2 sm:w-2.5 sm:h-2.5 rounded-full bg-brand-indigo/70"></span>
            <span class="w-2 h-2 sm:w-2.5 sm:h-2.5 rounded-full bg-brand-cyan/70"></span>
          </div>
        </div>

        <div class="bg-white/3 px-5 py-5 sm:px-7 sm:py-7 relative">
          <div class="absolute top-0 right-0 w-40 h-40 bg-brand-indigo/10 blur-[60px] rounded-full pointer-events-none"></div>

  <div class="bg-gray-800/80 p-6 md:p-8 rounded-2xl border border-gray-700 mt-6 md:mt-8 relative overflow-hidden group">
    <div class="absolute inset-0 bg-gradient-to-br from-brand-accent/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
    
    <div class="flex items-center gap-2 mb-6">
      <span class="text-xs font-bold tracking-widest text-brand-accent uppercase">Quick Form — 60 Seconds</span>
      <div class="h-px bg-gray-700 flex-grow ml-4"></div>
      <div class="flex gap-1">
        <div class="w-2 h-2 rounded-full bg-brand-accent animate-pulse"></div>
        <div class="w-2 h-2 rounded-full bg-brand-primary animate-pulse" style="animation-delay: 200ms"></div>
        <div class="w-2 h-2 rounded-full bg-brand-secondary animate-pulse" style="animation-delay: 400ms"></div>
      </div>
    </div>
    
    <h3 class="text-xl md:text-2xl font-bold text-white mb-6 md:mb-8 font-display">Tell us about your business</h3>
    
    <form id="audit-form" class="space-y-6">
      <div class="space-y-4">
        <div>
          <label for="name" class="block text-xs font-bold tracking-widest text-gray-400 uppercase mb-2">Business Name</label>
          <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
              <svg class="h-5 w-5 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
              </svg>
            </div>
            <input type="text" id="name" name="name" required
              class="w-full bg-gray-900/50 border border-gray-700 rounded-lg py-3 pl-11 pr-4 text-white placeholder-gray-500 focus:ring-2 focus:ring-brand-accent focus:border-brand-accent transition-colors"
              placeholder="e.g. Apex Fitness Studio">
          </div>
        </div>
        
        <div>
          <label for="email" class="block text-xs font-bold tracking-widest text-gray-400 uppercase mb-2">Email Address</label>
          <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
              <svg class="h-5 w-5 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <input type="email" id="email" name="email" required
              class="w-full bg-gray-900/50 border border-gray-700 rounded-lg py-3 pl-11 pr-4 text-white placeholder-gray-500 focus:ring-2 focus:ring-brand-accent focus:border-brand-accent transition-colors"
              placeholder="owner@yourbusiness.com">
          </div>
        </div>

        <div>
          <label for="phone" class="block text-xs font-bold tracking-widest text-gray-400 uppercase mb-2">Phone Number</label>
          <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
              <svg class="h-5 w-5 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
            </div>
            <input type="tel" id="phone" name="phone" required
              class="w-full bg-gray-900/50 border border-gray-700 rounded-lg py-3 pl-11 pr-4 text-white placeholder-gray-500 focus:ring-2 focus:ring-brand-accent focus:border-brand-accent transition-colors"
              placeholder="(555) 000-0000">
          </div>
        </div>
      </div>
      
      <div>
        <label class="block text-xs font-bold tracking-widest text-gray-400 uppercase mb-3 flex items-center gap-2">
          <svg class="w-4 h-4 text-brand-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          Best Time to Call
        </label>
        <div class="grid grid-cols-3 gap-3 md:gap-4 relative">
          <!-- Selection indicator background -->
          <div id="time-selector-bg" class="absolute inset-y-0 w-[calc(33.333%-0.66rem)] bg-brand-accent/20 rounded-xl border border-brand-accent/50 transition-all duration-300 ease-out left-0 hidden md:block"></div>
          
          <label class="cursor-pointer group relative z-10">
            <input type="radio" name="timeToCall" value="Morning" class="peer sr-only" required checked onchange="updateTimeSelector(0)">
            <div class="text-center p-3 md:p-4 rounded-xl border border-gray-700 bg-gray-900/50 hover:bg-gray-800 transition-all peer-checked:border-brand-accent peer-checked:text-brand-accent peer-checked:bg-brand-accent/10 md:peer-checked:bg-transparent md:peer-checked:border-transparent">
              <svg class="w-6 h-6 mx-auto mb-2 opacity-70 group-hover:opacity-100 transition-opacity" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
              </svg>
              <span class="block text-xs md:text-sm font-bold uppercase tracking-wider mb-1">Morning</span>
              <span class="block text-[10px] md:text-xs text-gray-500">9am - 12pm</span>
            </div>
          </label>
          <label class="cursor-pointer group relative z-10">
            <input type="radio" name="timeToCall" value="Afternoon" class="peer sr-only" required onchange="updateTimeSelector(1)">
            <div class="text-center p-3 md:p-4 rounded-xl border border-gray-700 bg-gray-900/50 hover:bg-gray-800 transition-all peer-checked:border-brand-accent peer-checked:text-brand-accent peer-checked:bg-brand-accent/10 md:peer-checked:bg-transparent md:peer-checked:border-transparent">
              <svg class="w-6 h-6 mx-auto mb-2 opacity-70 group-hover:opacity-100 transition-opacity" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z" />
              </svg>
              <span class="block text-xs md:text-sm font-bold uppercase tracking-wider mb-1">Noon</span>
              <span class="block text-[10px] md:text-xs text-gray-500">12pm - 5pm</span>
            </div>
          </label>
          <label class="cursor-pointer group relative z-10">
            <input type="radio" name="timeToCall" value="Evening" class="peer sr-only" required onchange="updateTimeSelector(2)">
            <div class="text-center p-3 md:p-4 rounded-xl border border-gray-700 bg-gray-900/50 hover:bg-gray-800 transition-all peer-checked:border-brand-accent peer-checked:text-brand-accent peer-checked:bg-brand-accent/10 md:peer-checked:bg-transparent md:peer-checked:border-transparent">
              <svg class="w-6 h-6 mx-auto mb-2 opacity-70 group-hover:opacity-100 transition-opacity" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
              </svg>
              <span class="block text-xs md:text-sm font-bold uppercase tracking-wider mb-1">Evening</span>
              <span class="block text-[10px] md:text-xs text-gray-500">5pm - 8pm</span>
            </div>
          </label>
        </div>
      </div>
      
      <button type="submit" id="submit-btn" class="w-full bg-brand-accent text-gray-900 font-bold py-4 px-8 rounded-lg text-lg hover:bg-white transition-all transform hover:-translate-y-1 hover:shadow-[0_10px_40px_-10px_rgba(0,240,255,0.5)] flex items-center justify-center gap-2 group relative overflow-hidden">
        <span class="relative z-10 flex items-center gap-2" id="submit-text">
          Get My Free Blueprint
          <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </span>
        <div id="submit-spinner" class="hidden relative z-10 w-5 h-5 border-2 border-gray-900 border-t-transparent rounded-full animate-spin"></div>
        <div class="absolute inset-0 bg-white scale-x-0 group-hover:scale-x-100 origin-left transition-transform duration-500 ease-out"></div>
      </button>
      
      <p class="text-center text-xs text-gray-500 flex items-center justify-center gap-2">
        <svg class="w-4 h-4 text-green-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
        </svg>
        Your information is 100% secure. We never spam.
      </p>
    </form>
  </div>
</div>

<script is:inline>
  // Add client-side submission logic to bypass Vercel Serverless Form stream crashing bugs
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('audit-form');
    if (!form) return;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const submitBtn = document.getElementById('submit-btn');
      const submitText = document.getElementById('submit-text');
      const submitSpinner = document.getElementById('submit-spinner');
      
      // Update UI to loading state
      submitBtn.disabled = true;
      submitBtn.classList.add('opacity-80', 'cursor-not-allowed');
      submitText.classList.add('hidden');
      submitSpinner.classList.remove('hidden');
      
      try {
        const formData = new FormData(form);
        const data = {
          name: formData.get('name'),
          email: formData.get('email'),
          phone: formData.get('phone'),
          timeToCall: formData.get('timeToCall')
        };
        
        const response = await fetch('/api/contact', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(data),
        });
        
        if (response.ok) {
          const result = await response.json();
          if (result.success) {
            window.location.href = '/?success=true';
          } else {
            window.location.href = `/?error=${result.error || 'server_error'}`;
          }
        } else {
          try {
            const errorResult = await response.json();
            window.location.href = `/?error=${errorResult.error || 'server_error'}`;
          } catch (e) {
            window.location.href = '/?error=server_error';
          }
        }
      } catch (error) {
        console.error("Submission Error:", error);
        window.location.href = '/?error=server_error';
      }
    });
  });

  function updateTimeSelector(index) {
    const bg = document.getElementById('time-selector-bg');
    if (bg) {
      bg.style.transform = `translateX(calc(${index * 100}% + ${index * 1}rem))`;
    }
  }
</script>
        </div>
      </div>
    </div>
  </div>
</dialog>

<style>
  dialog::backdrop {
    background-color: rgba(10, 15, 30, 0.85); /* Matches brand-midnight approx */
    backdrop-filter: blur(8px);
  }
  
  dialog {
    border: none;
    color: inherit;
  }
  
  dialog[open] {
    animation: modalSlideIn 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  
  @keyframes modalSlideIn {
    from {
      opacity: 0;
      transform: translateY(20px) scale(0.95);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }
</style>

<script>
  // Script to handle modal open/close logic from any button
  const modal = document.getElementById('auditModal') as HTMLDialogElement;
  const closeBtn = document.getElementById('closeAuditModal');
  
  // Close modal when clicking close button
  if (closeBtn && modal) {
    closeBtn.addEventListener('click', () => {
      modal.close();
    });
  }
  
  // Close modal when clicking outside the dialog content
  if (modal) {
    modal.addEventListener('click', (e) => {
      const dialogDimensions = modal.getBoundingClientRect();
      if (
        e.clientX < dialogDimensions.left ||
        e.clientX > dialogDimensions.right ||
        e.clientY < dialogDimensions.top ||
        e.clientY > dialogDimensions.bottom
      ) {
        modal.close();
      }
    });
  }

  // Export a function or handle custom events or data-attributes
  // For easier usage, let's add event listeners to all elements with data-open-modal="auditModal"
  document.querySelectorAll('[data-open-modal="auditModal"]').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      if (modal) {
        modal.showModal();
      }
    });
  });
</script>
