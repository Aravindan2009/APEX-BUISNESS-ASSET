---
// LeadCaptureFooter.astro
---
<footer class="pt-24 pb-12 relative overflow-hidden bg-brand-midnight">
  <div class="absolute top-0 left-1/4 w-[400px] h-[300px] bg-brand-indigo/15 blur-[100px] rounded-full pointer-events-none"></div>
  <div class="absolute top-0 right-1/4 w-[300px] h-[300px] bg-brand-cyan/10 blur-[100px] rounded-full pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">


    {/* Footer bottom bar */}
    <div class="flex flex-col md:flex-row justify-between items-center gap-6 border-t border-white/10 pt-8">
      <div class="flex items-center gap-3.5">
        <div class="relative flex items-center justify-center shrink-0 bg-white rounded-xl px-3 py-1.5">
          <img src="/logo.png" alt="Apex Business Asset Logo" class="h-10 w-auto object-contain" />
        </div>
        <div class="flex flex-col leading-none justify-center">
          <span class="text-white font-heading text-[1.05rem] font-bold tracking-tight mb-0.5">
            Apex <span class="text-brand-indigo">Business</span>
          </span>
          <span class="font-heading text-[0.6rem] font-bold tracking-[0.2em] uppercase text-white/50">Assets</span>
        </div>
      </div>
      <div class="text-sm text-white/50 flex gap-6">
        <a href="/privacy" class="hover:text-brand-cyan transition-colors">Privacy Policy</a>
        <a href="/terms" class="hover:text-brand-cyan transition-colors">Terms of Service</a>
      </div>
      <div class="text-sm text-white/50">
        &copy; {new Date().getFullYear()} Apex Business Assets. All rights reserved.
      </div>
    </div>
  </div>
</footer>
