---
// Navigation.astro
---
<header class="fixed top-0 w-full z-50 bg-brand-dark/95 backdrop-blur-xl border-b border-brand-primary/20 transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-20">

      {/* Logo */}
      <div class="flex-shrink-0 flex items-center">
        <a href="/" class="flex items-center gap-3 group">
          <div class="w-14 h-14 rounded-xl overflow-hidden flex items-center justify-center bg-[#FFFFFF] shrink-0">
            <img
              src="/logo.png"
              alt="Apex Business Assets Logo"
              class="w-12 h-12 object-contain group-hover:scale-105 transition-transform duration-300"
            />
          </div>
          <div class="flex flex-col leading-tight">
            <span class="text-brand-light font-heading text-lg font-bold tracking-tight">
              Apex <span class="text-brand-orange">Business</span>
            </span>
            <span class="text-brand-green font-heading text-xs font-semibold tracking-widest uppercase">Assets</span>
          </div>
        </a>
      </div>

      {/* Right Side Navigation */}
      <nav class="flex items-center gap-4">
        <div class="hidden md:flex space-x-8 items-center mr-4">
          <a href="#services" class="text-brand-muted hover:text-brand-orange transition-colors font-medium text-sm">Services</a>
          <a href="#benefits" class="text-brand-muted hover:text-brand-orange transition-colors font-medium text-sm">Our Approach</a>
        </div>
        <a href="#contact" class="btn-orange text-xs sm:text-sm py-2 px-4 sm:px-5 whitespace-nowrap">
          <span class="hidden sm:inline">Get Free Audit</span>
          <span class="sm:hidden">Free Audit</span>
        </a>
      </nav>

    </div>
  </div>
</header>
